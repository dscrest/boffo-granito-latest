# Optional: full Catalyst function base used by the Vite dev proxy.
# Defaults to the project's Development domain in vite.config.ts.
VITE_FUNCTION_HOST=https://boffo-granito-export-tracker-925638796.development.catalystserverless.com

# Optional: override the API base the client fetches from.
# Prod leaves this unset (same-origin "/server"). Set only for special dev setups.
# VITE_API_BASE=/server
#
# DEMO (Catalyst Slate, export-tracker-demo.onslate.com): the page and the functions
# are on different hosts, so the Slate deployment sets this build-time variable:
# VITE_API_BASE=https://export-tracker-demo-925638796.development.catalystserverless.com/server
#
# DEMO only (CR-454): no BOFFO branding — neutral "Demo" org fallback, no logo, text-only busy indicator
# (deploy-demo-client.sh and the Slate Git app set it).
# VITE_DEMO=1
